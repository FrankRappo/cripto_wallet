# ETH history (free, email-only registration on etherscan.io — no phone).
# Balance + send work without any key via public RPC (override node with ETH_RPC).
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
TONCENTER_API_KEY=
BSCSCAN_API_KEY=
TRONGRID_API_KEY=

# --- Опционально: свои RPC-узлы (по умолчанию публичные PublicNode) ---
# ETH_RPC=
# SOL_RPC=

# --- Monero (Вариант A): final_skript.py авто-запускает monero-wallet-rpc ---
# Заполни, если хочешь баланс/историю/отправку XMR (иначе — только генерация адресов).
# MONERO_WALLET_RPC=http://127.0.0.1:18083/json_rpc
# MONERO_WALLET_RPC_BIN=/path/to/vendor/monero/monero-wallet-rpc
# MONERO_WALLET_DIR=/path/to/.monero
# MONERO_WALLET_NAME=cripto_xmr
# MONERO_WALLET_PASSWORD=<пароль кошелька>
# MONERO_DAEMON_ADDR=xmr-node.cakewallet.com:18081
# MONERO_RPC_PORT=18083
